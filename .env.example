# Server Configuration
PORT=3000

# Cloud SQL / PostgreSQL (Optional - In-memory mock database is used when unset)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Gemini API
GEMINI_API_KEY=

# Firebase (Client configuration loaded from firebase-applet-config.json)
FIREBASE_API_KEY=
